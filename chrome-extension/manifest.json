{
  "manifest_version": 3,
  "name": "JEV Browser Companion",
  "version": "0.1.0",
  "minimum_chrome_version": "125",
  "description": "Подключите выбранную вкладку Chrome к JEV Browser в Codex.",
  "permissions": ["debugger", "tabs", "sidePanel", "storage", "webNavigation"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "action": {"default_title": "JEV Browser"},
  "side_panel": {"default_path": "panel.html"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:* http://127.0.0.1:*"}
}
