{
  "manifest_version": 3,
  "name": "JEV Browser Companion",
  "version": "0.1.1",
  "minimum_chrome_version": "125",
  "description": "JEV browser automation for Codex and Claude Code.",
  "permissions": [
    "debugger",
    "tabs",
    "sidePanel",
    "storage",
    "webNavigation",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "JEV Browser"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:* http://127.0.0.1:*"
  },
  "key": ""
}
