OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13
# Chrome is used if installed. Otherwise: npx playwright install chromium
JEV_BROWSER_CHANNEL=chrome
# Optional: attach to a browser you explicitly started with remote debugging.
# JEV_CDP_URL=http://127.0.0.1:9222
# Optional: persist records outside the plugin installation directory.
# JEV_DATA_DIR=/absolute/path/to/jev-data

# Default decision confidence threshold for new tasks (0..1).
JEV_MIN_CONFIDENCE=0.55
